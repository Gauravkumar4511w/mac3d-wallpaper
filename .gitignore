.DS_Store
node_modules/
*.log

# landing page build output (Vercel builds it from source)
landing page/dist/
landing page/dist-ssr/
.vercel/

# mac app build output (./build.sh recreates it). The DMG the site serves is
# kept at landing page/public/downloads/ so the Download button works.
mac app/build/

# Firebase app config for the Mac app's settings sync (build.sh also reads it
# from ~/.config/mac3d/). Not secret, but kept out of the public repo.
mac app/GoogleService-Info.plist
